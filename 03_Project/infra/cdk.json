{
  "app": "npx ts-node --prefer-ts-exts bin/ugrp.ts",
  "watch": { "exclude": ["**/node_modules/**", "cdk.out/**"] },
  "output": "cdk.out",
  "context": {
    "@aws-cdk/aws-ecs:disableEcsImdsBlocking": false,
    "@aws-cdk/aws-iam:minimizePolicies": true,

    "//crossStackRefs": "샤드 스택이 network·data의 값을 참조한다. strong이면 소비 중인 export를 생산자가 지울 수 없다 — 샤드를 띄운 채 데이터 평면을 건드리다 참조가 끊기는 사고를 막는다.",
    "@aws-cdk/core:defaultCrossStackReferences": "strong",

    "ugrp:region": "ap-northeast-2",
    "ugrp:shardCount": 20,
    "ugrp:experiment": "grid-v1",

    "//digests": "scripts/push-images.sh가 찍어준 값. 커밋 4311597로 빌드했다 — 이미지를 다시 만들면 태그(=커밋 SHA)와 다이제스트가 함께 바뀌므로 이 블록도 같은 커밋에서 갱신한다.",
    "ugrp:digests": {
      "sut": "sha256:ff79507e6105274e94ac68ec43583b9c7ae76db509721cd906ee2f5f9bc927a6",
      "worker": "sha256:53a5b2f01e6cf39bf26c92eb8ca804bd6ca5767b425a6231047d10b57f784512",
      "load": "sha256:af9b889ec194dfc5f903b12c492667b366967d0a9725985f70e53f632e03a222"
    }
  }
}
